---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Page not found"
  description="That page doesn't exist in the We Are Founders Tools Directory."
  noindex={true}
>
  <section class="page-hero container">
    <div class="page-hero__eyebrow">404</div>
    <h1>We couldn't find that page</h1>
    <p class="page-hero__lede">
      The link may be out of date, or the tool may have been delisted. Try one of
      these instead.
    </p>
    <p class="not-found__actions">
      <a class="btn btn--primary" href={base}>Browse all tools</a>
      <a class="btn btn--ghost" href={`${base}category/`}>Browse by category</a>
      <a class="btn btn--ghost" href={`${base}submit/`}>Submit a tool</a>
    </p>
  </section>
</BaseLayout>

<style>
  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 4rem;
  }
</style>
