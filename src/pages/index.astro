---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import FilterBar from '../components/FilterBar.astro';
import { STAGES, CATEGORIES } from '../data/taxonomy';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import LaunchDemo from '../components/LaunchDemo.astro';
import { DECLINE_RATE, QUEUE_COUNT } from '../data/review-stats';

const tools = await getCollection('tools', ({ data }) => data.published);
const sorted = tools.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.name.localeCompare(b.data.name);
});

// Static per-category counts for the sidebar
const categoryCounts: Record<string, number> = {};
sorted.forEach((tool) => {
  (tool.data.categories || []).forEach((slug: string) => {
    categoryCounts[slug] = (categoryCounts[slug] || 0) + 1;
  });
});

// Recently listed. Only listings with a listed_on date qualify, so the back
// catalogue (which predates the field) stays out rather than all claiming the
// same day. Fewer than four means the row is hidden entirely — better than
// padding it with tools that were listed months ago.
const recent = tools
  .filter((tool) => tool.data.listed_on instanceof Date)
  .sort((a, b) => b.data.listed_on.getTime() - a.data.listed_on.getTime())
  .slice(0, 4);

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="The We Are Founders Tools Directory"
  description="A curated, editorial directory of the tools that actually move the needle for founders. Filtered by category, founder stage, and pricing. Every entry is hand-reviewed."
  bodyClass="is-home"
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 class="hero__heading" id="hero-heading">
          Tools founders actually use, and the place to launch yours
        </h1>
        <p class="hero__lead">
          Every submission is reviewed by hand, and {DECLINE_RATE}% don't make the cut.
          The tools that do get a permanent listing, a shot at the trending bar, and
          a way into The Friday Brief.
        </p>
        <div class="hero__actions">
          <a class="btn btn--light" href={`${base}submit/`}>Launch your tool</a>
          <a class="btn btn--outline" href="#directory">Browse {tools.length} tools</a>
        </div>
        <p class="hero__queue">
          <span class="hero__queue-count">{QUEUE_COUNT} in queue</span>
          <span>
            Free listings are reviewed in order.
            <a href={`${base}promote/`}>Spotlight</a> gets you reviewed within 48 hours.
          </span>
        </p>
      </div>
      <LaunchDemo />
    </div>
  </section>

  {recent.length === 4 && (
    <section class="section recent-section" aria-labelledby="recent-heading">
      <div class="container">
        <div class="section__head">
          <h2 class="section__title" id="recent-heading">Recently listed</h2>
          <a class="section__link" href="#directory">See all tools</a>
        </div>
        <div class="tools-grid tools-grid--four">
          {recent.map((tool) => <ToolCard tool={tool} />)}
        </div>
      </div>
    </section>
  )}

  <div class="container" id="directory">
    <main class="directory-main directory-main--full">
      <div class="category-strip" id="category-strip-primary">
        <div class="category-strip__scroll-wrap">
          <button
            type="button"
            class="strip-arrow strip-arrow--prev"
            id="strip-prev"
            aria-label="Scroll categories left"
            hidden
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <div class="category-strip__pills" data-filter-group="category" id="category-pills-primary">
            <button type="button" class="pill" data-filter-value="all" aria-pressed="true">All</button>
            {CATEGORIES.map((c) => (
              <button type="button" class="pill" data-filter-value={c.slug} aria-pressed="false">
                {c.label}
                <span class="pill__count">{categoryCounts[c.slug] || 0}</span>
              </button>
            ))}
          </div>
          <button
            type="button"
            class="strip-arrow strip-arrow--next"
            id="strip-next"
            aria-label="Scroll categories right"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </button>
          <div class="category-strip__fade" aria-hidden="true"></div>
        </div>
      </div>

      <FilterBar hideCategoryFilter={true} />

      <div class="tools-grid tools-grid--three">
        {sorted.map((tool) => <ToolCard tool={tool} />)}
      </div>

      <div class="empty-state" id="empty-state" style="display: none;">
        <p>No tools match these filters yet. Try widening your selection.</p>
      </div>
    </main>

    <div class="section-heading">
      <h2>Tools for where you're at</h2>
    </div>
    <p class="section-lede">
      Stage-specific picks. Whether you're validating, building toward your first
      paying users, or growing past PMF, these are the tools we'd reach for.
    </p>
    <div class="tools-grid">
      {STAGES.map((s) => (
        <a href={`${base}stage/${s.slug}/`} class="tool-card">
          <div class="tool-card__head">
            <div class="tool-card__name">{s.label}</div>
          </div>
          <p class="tool-card__tagline">{s.desc}</p>
        </a>
      ))}
    </div>
  </div>

  <section class="brief-band" aria-labelledby="brief-heading">
    <div class="container brief-band__inner">
      <div class="brief-band__copy">
        <h2 class="section__title" id="brief-heading">The Friday Brief</h2>
        <p>
          One email a week with the tools worth your time, a product teardown, and
          what other founders are building.
        </p>
      </div>
      <div class="brief-band__form">
        <NewsletterSignup />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero layout is in global.css so the demo component can share the tokens.
     Nothing page-specific left here. */
</style>

<script>
  // Category strip: scroll arrows. Each click nudges the strip by ~75% of its
  // visible width. Arrows hide themselves at either end so they never look
  // clickable when there is nothing further to scroll to.
  const stripPills = document.getElementById('category-pills-primary');
  const stripPrev = document.getElementById('strip-prev');
  const stripNext = document.getElementById('strip-next');

  if (stripPills && stripPrev && stripNext) {
    const updateArrows = () => {
      const { scrollLeft, scrollWidth, clientWidth } = stripPills;
      const maxScroll = scrollWidth - clientWidth;
      // 2px tolerance for sub-pixel rounding at the extremes.
      stripPrev.hidden = scrollLeft <= 2;
      stripNext.hidden = scrollLeft >= maxScroll - 2;
    };

    const nudge = (direction: number) => {
      stripPills.scrollBy({
        left: direction * stripPills.clientWidth * 0.75,
        behavior: 'smooth',
      });
    };

    stripPrev.addEventListener('click', () => nudge(-1));
    stripNext.addEventListener('click', () => nudge(1));
    stripPills.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows, { passive: true });
    updateArrows();
  }
</script>

<script>
  // Homepage-only: header transitions from over-hero (purple/white text) to
  // cream once the user scrolls past the hero block. Uses IntersectionObserver
  // with rootMargin shrunk by the sticky header's height.
  const header = document.querySelector<HTMLElement>('.site-header');
  const hero = document.querySelector<HTMLElement>('.hero');

  if (header && hero) {
    let observer: IntersectionObserver | null = null;

    // Expose the header's measured height as a CSS variable so the hero
    // can pull itself up underneath the transparent header by exactly
    // the right amount.
    const setHeaderHeightVar = () => {
      document.documentElement.style.setProperty(
        '--site-header-h',
        `${header.offsetHeight}px`
      );
    };

    const setup = () => {
      observer?.disconnect();
      setHeaderHeightVar();
      const headerHeight = header.offsetHeight;
      observer = new IntersectionObserver(
        ([entry]) => {
          header.classList.toggle('site-header--past-hero', !entry.isIntersecting);
        },
        {
          rootMargin: `-${headerHeight}px 0px 0px 0px`,
          threshold: 0,
        }
      );
      observer.observe(hero);
    };

    setup();

    let resizeTimer: number;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(setup, 150);
    }, { passive: true });
  }
</script>
