---
import BaseLayout from '../layouts/BaseLayout.astro';

// CONFIGURE: Paste the public URL of your Tally tool-submission form below.
// This is the intake form that used to be set as the Stripe success URL.
// It is NOT the newsletter form (2ElR09) used on the homepage.
// Example: https://tally.so/r/XXXXXX
const TALLY_SUBMIT_FORM_URL = 'https://tally.so/r/PdvzgQ';

// Founder Stories live on the main publication, not this directory subdomain.
const STORIES_URL = 'https://wearefounders.uk/stories/';

// CONFIGURE: Update these two values when you clear the backlog or check Tally.
// QUEUE_LENGTH is the number of unreviewed free submissions currently waiting.
// QUEUE_UPDATED is shown to submitters so the number reads as live, not decorative.
const QUEUE_LENGTH = 172;
const QUEUE_UPDATED = 'August 5, 2026';

// Visual only. Caps how many dots render so very long queues stay readable.
const QUEUE_DOTS = Math.min(QUEUE_LENGTH, 180);

const base = import.meta.env.BASE_URL;

const steps = [
  {
    title: 'Submit',
    desc: "Send your tool's details. Takes a couple of minutes.",
    icon: 'upload',
  },
  {
    title: 'We review',
    desc: 'Free listings in 6 to 8 weeks. Fast-track in 48 hours.',
    icon: 'search',
  },
  {
    title: 'We write it',
    desc: 'A full entry in our house style, pricing verified.',
    icon: 'pencil',
  },
  {
    title: 'You go live',
    desc: 'Published in the directory, and it stays live.',
    icon: 'globe',
  },
];

const perks = [
  {
    title: 'A real editorial entry',
    desc: 'Written in our house style, with the same depth as the tools we pick ourselves.',
    icon: 'doc',
  },
  {
    title: 'Your link as the CTA',
    desc: 'Run an affiliate program? We use your tracked link. No program, a direct link to your site.',
    icon: 'link',
  },
  {
    title: 'Free, and it stays',
    desc: 'No fee to submit. Your listing stays live indefinitely, refreshed as things change.',
    icon: 'infinity',
  },
  {
    title: 'Fast-track for $49',
    desc: 'Optional. Reviewed in 48 hours instead of 6 to 8 weeks, and featured at the top of your category for 30 days, then kept on permanently.',
    icon: 'star',
  },
];

const accept = [
  'Live products that help founders, indie hackers, and early-stage operators',
  'Most categories: AI agents, automation, dev tools, finance ops, growth, sales CRM, productivity, design, hiring',
  'A genuine point of view or value-add',
];

const pass = [
  'Vapourware or pre-launch with no real product',
  'Thin wrappers around an AI API with nothing meaningful added',
  'Anything that breaks our content policies',
  'A user experience that lets the product down',
];

const faqs = [
  {
    q: 'Why is the free queue so long?',
    a: "Demand outgrew the review capacity. Every listing is written by hand, pricing is checked against the live site, and one person does that work, so the queue moves at the speed of real editorial rather than the speed of submissions. We would rather be honest about the wait than quietly sit on your entry. The queue number above is updated as we work through it.",
  },
  {
    q: "Can I submit a tool I don't own?",
    a: "Yes. Agencies, freelancers, and content marketers occasionally submit tools they're not affiliated with. We treat every submission the same way.",
  },
  {
    q: 'What does the $49 fast-track get me?',
    a: "Two things: your submission is reviewed within 48 hours instead of the current 6 to 8 week wait, and once live it sits at the top of its category for 30 days before settling into a standard, permanent listing. It buys speed and placement, not a softer review. Every tool clears the same editorial bar.",
  },
  {
    q: 'Is a paid listing a sponsored listing?',
    a: "No. Free or fast-tracked, every entry meets the same editorial standard and is written the same way, so nothing is marked sponsored. The $49 moves you up the queue and adds a featured window. It doesn't buy a place we wouldn't otherwise give you, and it doesn't change what we write.",
  },
  {
    q: 'Can I pay to skip the queue after I have already submitted?',
    a: "Yes. Email us with your tool name and we'll send you the fast-track link. Your original submission stays as it is, it just moves to the front.",
  },
  {
    q: 'What if my tool changes or I want to update the listing?',
    a: "Email us with the changes. A new pricing tier or an added feature is no problem. For a substantial repositioning, get in touch and we'll take a look.",
  },
  {
    q: 'Do you still feature tools for free?',
    a: "Yes. Beyond the paid fast-track, a handful of standout tools each month earn an editorial featured slot and a founder story on the main publication, entirely on merit and at no cost. Submitting well puts you in the running.",
  },
  {
    q: 'What if you reject my submission?',
    a: "We'll email you a short explanation. We reserve editorial judgement, and we do turn down a meaningful share of what comes in, usually on fit rather than quality. You're welcome to resubmit once you've addressed whatever held it back.",
  },
];
---
<BaseLayout
  title="Submit your tool · We Are Founders Directory"
  description="Submit your SaaS, agency tool, or founder product for editorial review and inclusion in the We Are Founders tools directory. Every entry is hand-reviewed."
>
  <section class="container submit">
    <!-- Hero -->
    <div class="submit__hero">
      <div class="submit__eyebrow">Editorial Submission</div>
      <h1 class="submit__heading">
        Get your tool in front of founders <em>who are looking for it</em>
      </h1>
      <p class="submit__lead">
        A curated directory of tools founders actually use. Hand-reviewed and
        live indefinitely. Free submissions are open, though the queue is long
        right now. Fast-track puts you at the front for $49.
      </p>
      <div class="submit__actions">
        <a href={TALLY_SUBMIT_FORM_URL} class="btn btn--primary" rel="noopener">
          Submit your tool
          <svg viewBox="0 0 24 24" class="btn__arrow" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={base} class="btn btn--ghost">Browse the directory</a>
      </div>
    </div>

    <!-- Queue -->
    <div class="queue">
      <div class="queue__head">
        <div>
          <div class="queue__tag">The queue right now</div>
          <h2 class="queue__title">
            <span class="queue__count">{QUEUE_LENGTH}</span>
            tools are waiting ahead of you
          </h2>
          <p class="queue__note">
            Updated {QUEUE_UPDATED}. We review by hand, in the order things
            arrive, and submissions are coming in faster than we can publish
            them. Free entries are taking 6 to 8 weeks.
          </p>
        </div>
      </div>

      <div class="queue__lanes">
        <!-- Free lane -->
        <div class="lane">
          <div class="lane__label">
            <span class="lane__name">Free</span>
            <span class="lane__eta">6 to 8 weeks</span>
          </div>
          <div class="lane__track" role="img" aria-label={`${QUEUE_LENGTH} submissions ahead of you in the free queue`}>
            {Array.from({ length: QUEUE_DOTS }).map(() => (
              <span class="dot"></span>
            ))}
            <span class="dot dot--you"></span>
          </div>
          <div class="lane__foot">
            <span class="lane__pin">You submit today, you land at #{QUEUE_LENGTH + 1}</span>
          </div>
        </div>

        <!-- Fast-track lane -->
        <div class="lane lane--fast">
          <div class="lane__label">
            <span class="lane__name">Fast-track · $49</span>
            <span class="lane__eta lane__eta--fast">48 hours</span>
          </div>
          <div class="lane__track lane__track--fast" role="img" aria-label="With fast-track you move to first in the queue">
            <span class="dot dot--you dot--first"></span>
          </div>
          <div class="lane__foot">
            <span class="lane__pin lane__pin--fast">You submit today, you land at #1</span>
          </div>
        </div>
      </div>

      <a href={TALLY_SUBMIT_FORM_URL} class="btn btn--primary queue__cta" rel="noopener">
        Skip the queue for $49
        <svg viewBox="0 0 24 24" class="btn__arrow" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <p class="queue__small">
        Or submit free and wait it out. Both routes get the same editorial
        treatment, and both stay live permanently.
      </p>
    </div>

    <!-- Flow -->
    <div class="flow" aria-label="How submission works">
      {steps.map((step, i) => (
        <div class="flow__step" style={`--d:${i * 70}ms`}>
          <div class="flow__badge">
            {step.icon === 'upload' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"/></svg>
            )}
            {step.icon === 'search' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            )}
            {step.icon === 'pencil' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M14 6l3 3"/></svg>
            )}
            {step.icon === 'globe' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/></svg>
            )}
          </div>
          <div class="flow__num">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="flow__title">{step.title}</h3>
          <p class="flow__desc">{step.desc}</p>
        </div>
      ))}
    </div>

    <!-- What you get -->
    <div class="block">
      <h2 class="block__title">What you get</h2>
      <div class="perks">
        {perks.map((perk, i) => (
          <div class="perk" style={`--d:${i * 60}ms`}>
            <div class="perk__badge">
              {perk.icon === 'doc' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h8l4 4v16H6z"/><path d="M14 2v4h4M9 13h6M9 17h6"/></svg>
              )}
              {perk.icon === 'link' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 6 .5l2-2a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-6-.5l-2 2A4 4 0 0 0 11.7 17l1-1"/></svg>
              )}
              {perk.icon === 'infinity' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9a3 3 0 1 0 0 6c2 0 3-1.5 5-3s3-3 5-3a3 3 0 1 1 0 6c-2 0-3-1.5-5-3"/></svg>
              )}
              {perk.icon === 'star' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.6 5.6 6 .7-4.4 4 1.2 6-5.4-3-5.4 3 1.2-6-4.4-4 6-.7z"/></svg>
              )}
            </div>
            <h3 class="perk__title">{perk.title}</h3>
            <p class="perk__desc">{perk.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- The bar -->
    <div class="block">
      <h2 class="block__title">Where the bar sits</h2>
      <div class="bar">
        <div class="bar__col bar__col--yes">
          <div class="bar__head">
            <svg viewBox="0 0 24 24" class="bar__mark" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
            <span>We accept</span>
          </div>
          <ul class="bar__list">
            {accept.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="bar__col bar__col--no">
          <div class="bar__head">
            <svg viewBox="0 0 24 24" class="bar__mark" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            <span>We pass on</span>
          </div>
          <ul class="bar__list">
            {pass.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <!-- Fast-track upsell -->
    <div class="featured">
      <div class="featured__inner">
        <div class="featured__tag">Fast-track · $49</div>
        <h2 class="featured__title">Skip the queue and start at the top</h2>
        <p class="featured__copy">
          With {QUEUE_LENGTH} tools already waiting, a free listing is a real
          wait. If you're launching or timing a push, fast-track gets you
          reviewed in 48 hours and featured at the top of your category for 30
          days. After that it stays on permanently as a standard listing. One
          payment, no subscription. It's also what keeps the directory free for
          everyone else.
        </p>
        <a href={TALLY_SUBMIT_FORM_URL} class="featured__link" rel="noopener">
          Fast-track your tool
          <svg viewBox="0 0 24 24" class="btn__arrow" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>

    <!-- Editorial featured upside -->
    <div class="featured featured--merit">
      <div class="featured__inner">
        <div class="featured__tag">For standout tools</div>
        <h2 class="featured__title">The best submissions get more than a listing</h2>
        <p class="featured__copy">
          Separate from the fast-track, a handful of products each month earn an
          editorial featured slot and a founder story on the main publication,
          the editorial that brings our audience here in the first place. That
          one's on merit, not money. Submit well and you put yourself in the
          running.
        </p>
        <a href={STORIES_URL} class="featured__link" rel="noopener">
          Read featured founder stories
          <svg viewBox="0 0 24 24" class="btn__arrow" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>

    <!-- FAQ -->
    <div class="block">
      <h2 class="block__title">Common questions</h2>
      <div class="faq">
        {faqs.map((faq) => (
          <details class="faq__item">
            <summary class="faq__q">
              {faq.q}
              <svg viewBox="0 0 24 24" class="faq__chev" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p class="faq__a">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>

    <!-- Closing CTA -->
    <div class="closer">
      <h2 class="closer__title">Ready when you are.</h2>
      <a href={TALLY_SUBMIT_FORM_URL} class="btn btn--primary btn--lg" rel="noopener">
        Submit your tool
        <svg viewBox="0 0 24 24" class="btn__arrow" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <p class="closer__small">Free listing at #{QUEUE_LENGTH + 1} in the queue, or fast-track to #1 for $49. Takes a couple of minutes either way.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .submit {
    /* width inherited from .container (var(--container), 1240px) so the
       page lines up with the homepage and header. */
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 5rem;
  }

  /* ---- Hero ---- */
  .submit__hero { max-width: 680px; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .submit__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--waf-accent);
    margin-bottom: 1rem;
  }
  .submit__heading {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 0 0 1.25rem;
  }
  .submit__heading em { font-style: italic; color: var(--waf-accent); font-weight: 500; }
  .submit__lead {
    font-size: 1.1875rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 2rem;
  }
  .submit__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* ---- Buttons ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }
  .btn--lg { padding: 1.0625rem 1.875rem; font-size: 1.0625rem; }
  .btn--primary { background: var(--waf-accent); color: #fff; }
  .btn--primary:hover { background: var(--waf-accent-hover); transform: translateY(-1px); }
  .btn--ghost { background: transparent; color: var(--text); border-color: var(--border-strong); }
  .btn--ghost:hover { border-color: var(--waf-accent); color: var(--waf-accent); }
  .btn__arrow { width: 1.1em; height: 1.1em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.15s ease; }
  .btn:hover .btn__arrow { transform: translateX(3px); }

  /* ---- Queue ---- */
  .queue {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }
  .queue__head { margin-bottom: 2rem; }
  .queue__tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--waf-accent);
    margin-bottom: 0.875rem;
  }
  .queue__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }
  .queue__count {
    font-variant-numeric: tabular-nums;
    color: var(--waf-accent);
  }
  .queue__note {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 62ch;
  }

  .queue__lanes { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 1.75rem; }

  .lane {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.125rem 1.25rem;
    background: var(--bg);
  }
  .lane--fast { border-color: var(--waf-accent); background: var(--waf-accent-soft); }

  .lane__label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.875rem;
  }
  .lane__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }
  .lane__eta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }
  .lane__eta--fast { color: var(--waf-accent); }

  .lane__track {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    min-height: 1.25rem;
    margin-bottom: 0.875rem;
  }
  .lane__track--fast { gap: 0; }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-strong);
    flex: 0 0 auto;
  }
  .dot--you {
    width: 11px;
    height: 11px;
    background: var(--waf-accent);
    box-shadow: 0 0 0 3px var(--waf-accent-soft);
    animation: pulse 2.4s ease-in-out infinite;
  }
  .dot--first { margin-left: 0; }

  .lane__foot { display: flex; }
  .lane__pin {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .lane__pin--fast { color: var(--waf-accent); font-weight: 600; }

  .queue__cta { margin-bottom: 0.875rem; }
  .queue__small {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
    max-width: 56ch;
    line-height: 1.55;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 3px var(--waf-accent-soft); }
    50% { box-shadow: 0 0 0 6px var(--waf-accent-soft); }
  }

  /* ---- Flow ---- */
  .flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }
  .flow__step {
    position: relative;
    padding-right: 1.25rem;
    animation: rise 0.5s ease both;
    animation-delay: var(--d, 0ms);
  }
  /* connector arrow between steps */
  .flow__step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 1.375rem;
    right: -0.25rem;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 2px solid var(--border-strong);
    border-right: 2px solid var(--border-strong);
    transform: rotate(45deg);
  }
  .flow__badge {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--waf-accent-soft);
    color: var(--waf-accent);
    margin-bottom: 1rem;
  }
  .flow__badge svg { width: 1.375rem; height: 1.375rem; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .flow__num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    margin-bottom: 0.375rem;
  }
  .flow__title { font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; margin: 0 0 0.375rem; letter-spacing: -0.01em; }
  .flow__desc { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.5; margin: 0; }

  /* ---- Blocks ---- */
  .block { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .block__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  /* ---- Perks grid ---- */
  .perks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .perk {
    padding: 1.625rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s ease, transform 0.2s ease;
    animation: rise 0.5s ease both;
    animation-delay: var(--d, 0ms);
  }
  .perk:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .perk__badge {
    width: 2.5rem; height: 2.5rem; border-radius: var(--radius);
    display: grid; place-items: center;
    background: var(--waf-accent-soft); color: var(--waf-accent);
    margin-bottom: 1rem;
  }
  .perk__badge svg { width: 1.3125rem; height: 1.3125rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .perk__title { font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; margin: 0 0 0.5rem; letter-spacing: -0.01em; }
  .perk__desc { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.55; margin: 0; }

  /* ---- The bar (accept / pass) ---- */
  .bar { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .bar__col {
    padding: 1.625rem 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
