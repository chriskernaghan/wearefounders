---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const steps = [
  {
    title: 'Get listed',
    desc: 'Every live listing has a share card in its sidebar, with buttons for X, LinkedIn, and copy link.',
    icon: 'card',
  },
  {
    title: 'Share your link',
    desc: 'Post your share link anywhere, X, LinkedIn, your newsletter, a group chat. Each link is tagged to your tool.',
    icon: 'share',
  },
  {
    title: 'People click',
    desc: 'Every click on your tagged link counts. The more real people who follow it, the stronger your week.',
    icon: 'cursor',
  },
  {
    title: 'You trend',
    desc: 'Each week the three most-clicked listings take the top spots in the trending bar, seen on every page.',
    icon: 'trophy',
  },
];
---
<BaseLayout
  title="How trending works · We Are Founders Directory"
  description="The three trending spots on We Are Founders are earned, not bought. Here's exactly how the weekly trending bar is decided, and how your tool can appear in it."
>
  <section class="container trending-explain">
    <!-- Hero -->
    <div class="te__hero">
      <div class="te__eyebrow">Trending this week</div>
      <h1 class="te__heading">
        The top three are <em>earned, not bought</em>
      </h1>
      <p class="te__lead">
        You can't pay to trend. The three tools in the bar at the top of the site are
        simply the ones founders shared the most this week. Share your listing, get
        people clicking, and you climb. Here's exactly how it works.
      </p>
    </div>

    <!-- Flow -->
    <div class="flow" aria-label="How trending works">
      {steps.map((step, i) => (
        <div class="flow__step" style={`--d:${i * 70}ms`}>
          <div class="flow__badge">
            {step.icon === 'card' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
            )}
            {step.icon === 'share' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
            )}
            {step.icon === 'cursor' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l6 18 2.5-7.5L21 11z"/></svg>
            )}
            {step.icon === 'trophy' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v4a5 5 0 0 1-10 0z"/><path d="M7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3M9 18h6M10 14v4M14 14v4"/></svg>
            )}
          </div>
          <div class="flow__num">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="flow__title">{step.title}</h3>
          <p class="flow__desc">{step.desc}</p>
        </div>
      ))}
    </div>

    <!-- The rule -->
    <div class="te__panel">
      <div class="te__panel-inner">
        <div class="te__tag">The one rule</div>
        <h2 class="te__panel-title">More shares, more clicks, more chance of a top spot</h2>
        <p class="te__panel-copy">
          We tally the clicks on every listing's share link each week and the three
          highest take the trending spots. That's the whole formula. It rewards the
          founders who actually get their tool in front of people, which is the point.
          A quieter week means someone else climbs, so it stays fresh.
        </p>
      </div>
    </div>

    <!-- Honesty note -->
    <div class="block">
      <h2 class="block__title">A few honest notes</h2>
      <div class="te__notes">
        <div class="te__note">
          <h3>You can't buy a spot</h3>
          <p>Trending is separate from our paid packages. No amount of money moves you into the bar, only real shares do.</p>
        </div>
        <div class="te__note">
          <h3>Real clicks only</h3>
          <p>We look for genuine engagement, not bots or self-refreshing. Padding the numbers won't help you and may cost you the spot.</p>
        </div>
        <div class="te__note">
          <h3>It resets weekly</h3>
          <p>The board is recalculated every week, so a strong push gets rewarded quickly and nobody sits at the top forever.</p>
        </div>
      </div>
    </div>

    <!-- Closing CTA -->
    <div class="closer">
      <h2 class="closer__title">Ready to climb</h2>
      <a href={base} class="btn btn--primary btn--lg">
        Find your listing
        <svg viewBox="0 0 24 24" class="btn__arrow" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <p class="closer__small">Open your tool's page, hit share, and start the week strong.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .trending-explain {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 5rem;
  }

  /* ---- Hero ---- */
  .te__hero { max-width: 680px; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .te__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--waf-accent);
    margin-bottom: 1rem;
  }
  .te__heading {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 0 0 1.25rem;
  }
  .te__heading em { font-style: italic; color: var(--waf-accent); font-weight: 500; }
  .te__lead {
    font-size: 1.1875rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 0;
  }

  /* ---- Buttons ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }
  .btn--lg { padding: 1.0625rem 1.875rem; font-size: 1.0625rem; }
  .btn--primary { background: var(--waf-accent); color: #fff; }
  .btn--primary:hover { background: var(--waf-accent-hover); transform: translateY(-1px); }
  .btn__arrow { width: 1.1em; height: 1.1em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.15s ease; }
  .btn:hover .btn__arrow { transform: translateX(3px); }

  /* ---- Flow ---- */
  .flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }
  .flow__step {
    position: relative;
    padding-right: 1.25rem;
    animation: rise 0.5s ease both;
    animation-delay: var(--d, 0ms);
  }
  .flow__step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 1.375rem;
    right: -0.25rem;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 2px solid var(--border-strong);
    border-right: 2px solid var(--border-strong);
    transform: rotate(45deg);
  }
  .flow__badge {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--waf-accent-soft);
    color: var(--waf-accent);
    margin-bottom: 1rem;
  }
  .flow__badge svg { width: 1.375rem; height: 1.375rem; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .flow__num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    margin-bottom: 0.375rem;
  }
  .flow__title { font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; margin: 0 0 0.375rem; letter-spacing: -0.01em; }
  .flow__desc { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.5; margin: 0; }

  /* ---- Blocks ---- */
  .block { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .block__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  /* ---- The rule panel ---- */
  .te__panel {
    background: var(--waf-accent-soft);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }
  .te__panel-inner { max-width: 620px; }
  .te__tag {
    font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--waf-accent); margin-bottom: 0.875rem;
  }
  .te__panel-title {
    font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 0.875rem;
    color: var(--text);
  }
  .te__panel-copy { font-size: 1.0625rem; color: var(--text-muted); line-height: 1.55; margin: 0; }

  /* ---- Notes grid ---- */
  .te__notes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .te__note {
    padding: 1.625rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .te__note h3 { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; margin: 0 0 0.5rem; letter-spacing: -0.01em; }
  .te__note p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.55; margin: 0; }

  /* ---- Closer ---- */
  .closer { text-align: center; padding-top: 1rem; }
  .closer__title { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600; letter-spacing: -0.02em; margin: 0 0 1.5rem; }
  .closer__small { font-size: 0.8125rem; color: var(--text-muted); margin: 1rem 0 0; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ---- Responsive ---- */
  @media (max-width: 860px) {
    .flow { grid-template-columns: repeat(2, 1fr); gap: 1.75rem 1.25rem; }
    .flow__step:nth-child(2)::after { display: none; }
    .te__notes { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .flow { grid-template-columns: 1fr; gap: 0; }
    .flow__step {
      margin-left: 1.375rem;
      padding: 0 0 2rem 1.75rem;
      border-left: 2px solid var(--border);
    }
    .flow__step:last-child { border-left-color: transparent; padding-bottom: 0; }
    .flow__step::after { display: none !important; }
    .flow__badge { margin-left: -3.125rem; background: var(--bg); box-shadow: 0 0 0 6px var(--bg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__step { animation: none; }
  }
</style>
