---
import { CATEGORY_MAP, STAGE_MAP } from '../data/taxonomy';
interface Props {
  tool: {
    id: string;
    data: {
      name: string;
      tagline: string;
      categories: string[];
      stages: string[];
      pricing_from: number | null;
      pricing_currency: string;
      free_tier: boolean;
      featured?: boolean;
      website?: string;
      logo?: string;
    };
  };
}
const { tool } = Astro.props;
const base = import.meta.env.BASE_URL;
const slug = tool.id.replace(/\.md$/, '');
const symbol = tool.data.pricing_currency === 'GBP' ? '£' : tool.data.pricing_currency === 'EUR' ? '€' : tool.data.pricing_currency === 'CHF' ? 'CHF ' : '$';
// Pricing display string. "From $X" pattern keeps copy future-proof.
let priceLabel: string;
if (tool.data.pricing_from === null) {
  priceLabel = 'Custom';
} else if (tool.data.pricing_from === 0) {
  priceLabel = 'Free';
} else {
  priceLabel = `From ${symbol}${tool.data.pricing_from}`;
}
// Logo resolution:
// 1. If tool.data.logo is set, use it (real brand asset).
// 2. Otherwise pull the site's favicon via DuckDuckGo's icon service.
//    Unlike Google S2 (which serves a generic globe with a 200 status for
//    sites lacking an icon, so onerror never fires), DuckDuckGo returns an
//    error for missing icons, which trips the <img> onerror and reveals the
//    monogram behind it. Net: real favicons where they exist, monograms
//    where they don't, never a globe.
let logoUrl: string | null = tool.data.logo ?? null;
if (!logoUrl && tool.data.website) {
  try {
    const domain = new URL(tool.data.website).hostname;
    logoUrl = `https://icons.duckduckgo.com/ip3/${domain}.ico`;
  } catch {
    logoUrl = null;
  }
}
const monogram = tool.data.name.trim().charAt(0).toUpperCase();
// Build data-attributes used by the client-side filter.
const categoriesAttr = tool.data.categories.join(',');
const stagesAttr = tool.data.stages.join(',');
---
<a
  class:list={["tool-card", { "tool-card--featured": tool.data.featured }]}
  href={`${base}${slug}/`}
  data-tool
  data-featured={tool.data.featured ? 'true' : 'false'}
  data-categories={categoriesAttr}
  data-stages={stagesAttr}
  data-free-tier={tool.data.free_tier ? 'true' : 'false'}
>
  {tool.data.featured && <span class="tool-card__featured-badge">Featured</span>}
  <div class="tool-card__head">
    <div class="tool-card__head-left">
      <span class="tool-card__logo-wrap">
        {logoUrl && (
          <img
            class="tool-card__logo"
            src={logoUrl}
            alt={`${tool.data.name} logo`}
            loading="lazy"
            width="32"
            height="32"
            onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex'"
          />
        )}
        <span
          class="tool-card__logo tool-card__logo--monogram"
          style={logoUrl ? 'display:none' : undefined}
          aria-hidden="true"
        >{monogram}</span>
      </span>
      <div class="tool-card__name">{tool.data.name}</div>
    </div>
    <div class="tool-card__price">
      {tool.data.free_tier && tool.data.pricing_from !== 0 && (
        <><strong>Free tier</strong><br /></>
      )}
      <strong>{priceLabel}</strong>
    </div>
  </div>
  <p class="tool-card__tagline">{tool.data.tagline}</p>
  <div class="tool-card__meta">
    {tool.data.categories.slice(0, 2).map((slug) => (
      <span class="pill">{CATEGORY_MAP[slug]?.label ?? slug}</span>
    ))}
    {tool.data.stages.map((slug) => (
      <span class="pill">{STAGE_MAP[slug]?.label ?? slug}</span>
    ))}
  </div>
</a>
