---
import { CATEGORIES } from '../data/taxonomy';

interface Props {
  hideCategoryFilter?: boolean;
  hideStageFilter?: boolean;
}

const { hideCategoryFilter = false } = Astro.props;
---
{!hideCategoryFilter && (
  <div class="category-strip" id="category-strip">
    <div class="category-strip__scroll-wrap">
      <div class="category-strip__pills" data-filter-group="category" id="category-pills">
        <button type="button" class="pill" data-filter-value="all" aria-pressed="true">All</button>
        {CATEGORIES.map((c) => (
          <button type="button" class="pill" data-filter-value={c.slug} aria-pressed="false">
            {c.label}
          </button>
        ))}
      </div>
      <div class="category-strip__fade" aria-hidden="true"></div>
    </div>
  </div>
)}

<div class="filter-bar" id="filter-bar">
  <div class="container filter-bar__inner">
    <div class="filter-bar__left">
      <span class="filter-bar__count" id="filter-count">Loading…</span>
    </div>
    <div class="filter-bar__right">
      <label class="sort-control">
        <span class="sort-control__label">Sort</span>
        <select class="sort-control__select" id="sort-select">
          <option value="az">A–Z</option>
          <option value="recent">Recently added</option>
          <option value="featured">Featured first</option>
        </select>
      </label>
      <label class="toggle" data-filter-group="freetier">
        <span class="toggle__label">Free tier only</span>
        <input type="checkbox" class="toggle__input" id="freetier-toggle" />
        <span class="toggle__track" aria-hidden="true">
          <span class="toggle__thumb"></span>
        </span>
      </label>
    </div>
  </div>
</div>

<script>
  type GroupName = 'stage' | 'category' | 'freetier';
  const state: Record<GroupName, string> = {
    stage: 'all',
    category: 'all',
    freetier: 'all',
  };
  // Sort mode is separate from the filter groups. Default A-Z.
  let sortMode: 'az' | 'recent' | 'featured' = 'az';

  // Reorder the cards in the DOM. Featured tools are ALWAYS pinned to the top,
  // regardless of sort mode; the chosen sort then applies within the featured
  // block and within the rest. Sorting the whole node list (not just visible
  // ones) keeps order stable as filters change. CSS grid reflows to match DOM
  // order, so moving the nodes is all that's needed.
  function sortGrid() {
    const grid = document.querySelector<HTMLElement>('.tools-grid');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-tool]'));
    if (cards.length === 0) return;

    const byName = (a: HTMLElement, b: HTMLElement) =>
      (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
    const byDateDesc = (a: HTMLElement, b: HTMLElement) =>
      (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '');

    const withinGroup =
      sortMode === 'recent' ? byDateDesc : byName; // 'featured' + 'az' both A-Z within group

    cards.sort((a, b) => {
      const aFeat = a.dataset.featured === 'true';
      const bFeat = b.dataset.featured === 'true';
      if (aFeat !== bFeat) return aFeat ? -1 : 1; // featured pinned on top always
      return withinGroup(a, b);
    });

    // Re-append in the new order. Appending an existing node moves it.
    cards.forEach((card) => grid.appendChild(card));
  }

  function apply() {
    const tools = document.querySelectorAll<HTMLElement>('[data-tool]');
    let visible = 0;

    tools.forEach((el) => {
      const cats = (el.dataset.categories ?? '').split(',');
      const stages = (el.dataset.stages ?? '').split(',');
      const freeTier = el.dataset.freeTier ?? 'false';

      const matchesStage = state.stage === 'all' || stages.includes(state.stage);
      const matchesCategory = state.category === 'all' || cats.includes(state.category);
      const matchesFree = state.freetier === 'all' || freeTier === state.freetier;

      const show = matchesStage && matchesCategory && matchesFree;
      el.dataset.hidden = show ? 'false' : 'true';
      if (show) visible++;
    });

    const count = document.getElementById('filter-count');
    if (count) {
      count.textContent = `${visible} ${visible === 1 ? 'tool' : 'tools'}`;
    }

    const emptyState = document.getElementById('empty-state');
    if (emptyState) {
      emptyState.style.display = visible === 0 ? 'block' : 'none';
    }
  }

  // Category pills (single-select)
  document.querySelectorAll<HTMLElement>('[data-filter-group="category"]').forEach((group) => {
    group.querySelectorAll<HTMLButtonElement>('button[data-filter-value]').forEach((btn) => {
      btn.addEventListener('click', () => {
        group.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
          b.setAttribute('aria-pressed', 'false');
        });
        btn.setAttribute('aria-pressed', 'true');
        state.category = btn.dataset.filterValue ?? 'all';
        apply();
      });
    });
  });

  // Stage pills (used on stage pages)
  document.querySelectorAll<HTMLElement>('[data-filter-group="stage"]').forEach((group) => {
    group.querySelectorAll<HTMLButtonElement>('button[data-filter-value]').forEach((btn) => {
      btn.addEventListener('click', () => {
        group.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
          b.setAttribute('aria-pressed', 'false');
        });
        btn.setAttribute('aria-pressed', 'true');
        state.stage = btn.dataset.filterValue ?? 'all';
        apply();
      });
    });
  });

  // Free tier toggle
  const freeTierToggle = document.getElementById('freetier-toggle') as HTMLInputElement | null;
  if (freeTierToggle) {
    freeTierToggle.addEventListener('change', () => {
      state.freetier = freeTierToggle.checked ? 'true' : 'all';
      apply();
    });
  }

  // Sort dropdown. Reorders the grid, then re-applies filters so the visible
  // count and empty state stay correct. Featured stays pinned in every mode.
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  if (sortSelect) {
    sortSelect.addEventListener('change', () => {
      sortMode = (sortSelect.value as typeof sortMode) || 'az';
      sortGrid();
      apply();
    });
  }

  // Initial order: A-Z with featured pinned (matches the default option).
  sortGrid();
  apply();
</script>
